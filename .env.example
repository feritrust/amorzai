# آدرس کانونیکال سایت — برای metadataBase، sitemap، canonical و Open Graph استفاده می‌شود
NEXT_PUBLIC_SITE_URL=https://amorz.ir

# اتصال MongoDB. اگر خالی باشد سایت از داده‌های داخلی (src/data/seed.js) استفاده می‌کند
MONGODB_URI=
MONGODB_DB=amorz

# اطلاعات تماس (در فوتر، schema و دکمه تماس نمایش داده می‌شود)
NEXT_PUBLIC_PHONE=02155005000
NEXT_PUBLIC_MOBILE=09120000000

# تایید مالکیت سرچ کنسول گوگل
GOOGLE_SITE_VERIFICATION=

# کلید محافظت از مسیر revalidate
SEED_SECRET=change-me

# --- پنل مدیریت (/admin) ---
# رمز ورود به پنل. حتماً یک رمز قوی بگذارید.
ADMIN_PASSWORD=
# کلید امضای کوکی نشست. اگر خالی باشد از ADMIN_PASSWORD استفاده می‌شود.
# یک رشته تصادفی طولانی بگذارید تا با تغییر رمز، نشست‌ها باطل نشوند.
ADMIN_SECRET=

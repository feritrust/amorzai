# تصاویر آپلودشده از پنل (خود پوشه بماند)
public/uploads/*
!public/uploads/.gitkeep
# عکس‌های آماده‌شده محصولات با پیشوند amorz- در مخزن نگهداری می‌شوند
# تا با هر دیپلوی روی سرور هم باشند. آپلودهای پنل همچنان نادیده گرفته می‌شوند.
!public/uploads/amorz-*.webp

# خروجی‌های سرچ کنسول و گزارش‌های بررسی — محلی می‌مانند
seo-data/*
!seo-data/README.md
seo-report.md

# فایل‌های تولیدی برند (با python3 brand/generate.py دوباره ساخته می‌شوند)
brand/*.png

# عکس‌های خام ورودی — نسخه آماده‌شده در public/uploads است
photos/
